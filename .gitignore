# ─── Secrets ──────────────────────────────────────────────────────────────────
# The GitHub token is read from the environment only and must never be committed.
.env
.env.*
!.env.example
*token*.txt
*credentials*

# ─── Generated working data ───────────────────────────────────────────────────
# Recreated by running the pipeline; large and high-churn.
repository_cache/
github_api_cache/
execution_logs/
worktrees/
repo_snapshots/
cache/
logs/
*.log

# ─── Databases ────────────────────────────────────────────────────────────────
# The research pool grows to tens of gigabytes. The results database is small
# enough to share, but is distributed alongside the code rather than committed.
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.parquet

# ─── Exports ──────────────────────────────────────────────────────────────────
# Regenerated with: run_regression_pipeline.py export
data/*.csv
output/
outputs/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
_venv/

# ─── Editor and OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ─── Local backups and scratch ────────────────────────────────────────────────
*.bak
*.bak_*
*.orig
*.stackdump
_not_for_handoff/
